# GitIssue Frontend Environment Variables
# Copy to frontend/.env.local for local overrides

# Backend API base URL (FastAPI)
VITE_API_BASE_URL=http://localhost:8000

# Clerk Authentication Publishable Key (starts with pk_test_ or pk_live_)
# Leave blank during offline local dev to use development fallback mode
VITE_CLERK_PUBLISHABLE_KEY=
