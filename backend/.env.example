# GitIssue Backend Environment Variables
# Neon PostgreSQL Connection String (configured locally and in Render environment variables)
# Format: postgresql://USER:PASSWORD@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=
GITHUB_TOKEN=
CLERK_JWKS_URL=
CLERK_ISSUER=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://gitissue.vercel.app
MAX_ISSUES_CAP=1000
MAX_CONCURRENT_ANALYSES=2
MAX_ANALYSES_PER_USER_PER_HOUR=10
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
